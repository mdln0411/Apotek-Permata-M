# Salin ke .env — IP opsional (app otomatis pakai IP dari Expo saat dev)
# Jangan set EXPO_PUBLIC_API_URL kecuali IP otomatis salah:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
LAN_IP=10.205.0.184

# Menjalankan app:
#   npm run dev          → backend + expo (dua jendela)
#   npm run backend      → Laravel saja (port 8000)
#   npx expo start -c    → Expo saja (port 8081, proxy API ke Laravel)
