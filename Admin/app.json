{
  "expo": {
    "name": "Apotek Permata",
    "slug": "apotek-permata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "apotek",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D7A4F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.apotekpermata.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D7A4F"
      },
      "package": "com.apotekpermata.app"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
