{
  "expo": {
    "name": "apotek-permata",
    "slug": "apotek-permata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apotekpermata",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apotekpermata.app",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Aplikasi membutuhkan izin untuk menyimpan QR Code QRIS ke galeri foto Anda.",
        "NSPhotoLibraryUsageDescription": "Aplikasi membutuhkan izin galeri foto untuk menyimpan QR Code QRIS."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.apotekpermata.app",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8FBF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Izinkan $(PRODUCT_NAME) mengakses foto untuk menyimpan QRIS.",
          "savePhotosPermission": "Izinkan $(PRODUCT_NAME) menyimpan QR Code QRIS ke galeri foto.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8FBF8",
          "dark": {
            "backgroundColor": "#1B5E20"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {}
  }
}
